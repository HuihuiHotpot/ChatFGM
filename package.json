{
  "name": "chatfgm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "build:renderer": "vite build",
    "build:desktop": "npm run typecheck && npm run build:renderer && node scripts/build-desktop.mjs",
    "run:desktop": "node scripts/run-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview:test": "vite --config test/frontend/vite.preview.config.ts",
    "test:ui": "playwright test --config test/playwright.config.ts",
    "test:storage": "node test/backend/run-storage-tests.mjs",
    "test:desktop": "playwright test --config test/desktop/playwright.config.ts",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "dompurify": "^3.4.17",
    "h5wasm": "0.10.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
